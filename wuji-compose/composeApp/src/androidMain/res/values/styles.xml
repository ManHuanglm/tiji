<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        应用启动主题 - 纯 Compose + Material3 项目推荐用法:
        不继承 AppCompat/Material 的 XML 主题体系(避免引入额外依赖),
        直接基于平台 DeviceDefault.Light.NoActionBar,仅配置窗口级属性。
        Material3 的主题色/字体/形状全部由 Compose 端的 WujiTheme 控制。

        红米 K50 / MIUI 关键兼容点:
        1. 显式声明 windowSplashScreenBehavior,防止 MIUI 强制注入自己的 Splash 主题导致崩溃
        2. 不使用 @android:style/Theme.Material.Light.NoActionBar,
           该主题为 Android L 时代的平台 Material,与现代 Material3 Compose 不兼容,
           在 MIUI 上会出现 Theme/Attribute 解析失败直接闪退
    -->
    <style name="Theme.Wuji" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@color/status_bar_transparent</item>
        <item name="android:navigationBarColor">@color/status_bar_transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Android 12+ Splash Screen API (MIUI 适配必需) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/bg_splash_icon</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <!-- 深色模式变体 - values-night 会自动覆盖;此处声明供代码切换兜底 -->
    <style name="Theme.Wuji.Dark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@color/status_bar_transparent</item>
        <item name="android:navigationBarColor">@color/status_bar_transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
